# trading_assistant_agent source-request and data-refresh environment.
# Copy to .env and fill in real values on the machine that will declare source
# requests and run read-only historical data refreshes.

# ---------------------------------------------------------------------------
# Workspace paths
# ---------------------------------------------------------------------------
TA_AGENT_ROOT=C:/Users/sehyu/Documents/Other/Projects/trading_assistant_agent
TA_DATA_REPO_ROOT=C:/Users/sehyu/Documents/Other/Projects/trading_assistant_agent/packages/trading_assistant_data
TA_BACKTEST_REPO_ROOT=C:/Users/sehyu/Documents/Other/Projects/trading_assistant_agent/packages/trading_assistant_backtest
TA_REFERENCES_ROOT=C:/Users/sehyu/Documents/Other/Projects/trading_assistant_agent/_references
TA_TRADING_REPO_ROOT=C:/Users/sehyu/Documents/Other/Projects/trading_assistant_agent/_references/trading
TA_K_STOCK_TRADER_REPO_ROOT=C:/Users/sehyu/Documents/Other/Projects/trading_assistant_agent/_references/k_stock_trader
TA_CRYPTO_TRADER_REPO_ROOT=C:/Users/sehyu/Documents/Other/Projects/trading_assistant_agent/_references/crypto_trader

# ---------------------------------------------------------------------------
# Source-request declaration
# ---------------------------------------------------------------------------
TA_LEGACY_SNAPSHOT_ID=2026-05-30
TA_LEGACY_IMPORT_ROOT=packages/trading_assistant_data/data/imported/reference_snapshot_2026-05-30
TA_SOURCE_REQUEST_ROOT=packages/trading_assistant_data/data/source_requests
TA_SOURCE_REQUEST_MANIFEST=packages/trading_assistant_data/data/source_requests/source_request_manifest.json
TA_SOURCE_REQUEST_REPORT_ROOT=packages/trading_assistant_data/data/validation_reports/source_requests
TA_SOURCE_REQUEST_OVERWRITE=false
TA_SOURCE_REQUEST_REQUIRE_LEGACY_FILE=true
TA_SOURCE_REQUEST_INCLUDE_CRYPTO=true
TA_SOURCE_REQUEST_INCLUDE_TRADING_MOMENTUM=true
TA_SOURCE_REQUEST_INCLUDE_TRADING_SWING=true
TA_SOURCE_REQUEST_INCLUDE_TRADING_STOCK=true
TA_SOURCE_REQUEST_INCLUDE_K_STOCK=true

# ---------------------------------------------------------------------------
# Refresh safety switches
# ---------------------------------------------------------------------------
TA_SOURCE_REFRESH_DRY_RUN=true
TA_SOURCE_REFRESH_ALLOW_NETWORK=false
TA_SOURCE_REFRESH_ALLOW_WRITE=false
TA_SOURCE_REFRESH_REQUIRE_CLEAN_GIT=true
TA_SOURCE_REFRESH_REQUIRE_READ_ONLY_ACK=true
TA_SOURCE_REFRESH_OVERLAP_BARS=200
TA_SOURCE_REFRESH_LOOKBACK_DAYS=30
TA_SOURCE_REFRESH_START=
TA_SOURCE_REFRESH_END=

# ---------------------------------------------------------------------------
# IBKR historical market-data refresh
# IBKR uses a running TWS/Gateway session, not API keys.
# ---------------------------------------------------------------------------
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=107
IBKR_READ_ONLY_ACK=false
IBKR_ACCOUNT_ID=
IBKR_TRADING_MODE=paper
IBKR_TIMEOUT_SECONDS=60
IBKR_PACING_POLICY=ibkr_historical_bars_pacing_v1
IBKR_DEFAULT_EXCHANGE=SMART
IBKR_CME_EXCHANGE=CME
IBKR_DEFAULT_CURRENCY=USD
IBKR_DEFAULT_WHAT_TO_SHOW=TRADES
IBKR_DEFAULT_USE_RTH=false
IBKR_US_EQUITY_USE_RTH=true
IBKR_CME_USE_RTH=false
IBKR_CME_ROLL_POLICY=cme_quarterly_four_calendar_days_before_third_friday_v1
IBKR_CME_CONTRACT_CHAIN_SOURCE=packages/trading_assistant_data/data/reference/cme/contract_chains
IBKR_ENABLE_PHYSICAL_CONTRACT_BACKFILL=false

# Optional if this machine also starts/manages IB Gateway.
TWS_USERID=
TWS_PASSWORD=

# ---------------------------------------------------------------------------
# KIS/KRX historical market-data refresh
# KIS credentials are required to execute downloads, not to declare requests.
# ---------------------------------------------------------------------------
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_IS_PAPER=true
KIS_ACCOUNT_MODE=paper
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCESS_TOKEN=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PROD_CODE=01
KIS_HTS_ID=
KIS_MY_AGENT=Mozilla/5.0
KIS_READ_ONLY_ACK=false
KIS_PACING_POLICY=kis_market_data_pacing_v1
KIS_REQUEST_MIN_INTERVAL_SECONDS=2.0
KIS_EXTRA_SLEEP_SECONDS=0.55
KIS_INTRADAY_MAX_PAGES=
KIS_KRX_MARKET_CODE=J
KIS_KRX_SESSION_POLICY=krx_equities_kis_intraday_continuous_auction_v1
KIS_KRX_DAILY_ADJUSTMENT_POLICY=krx_split_adjusted_policy_v1

# ---------------------------------------------------------------------------
# LRS / local KRX research exports
# LRS is a local research input, not a live refresh source.
# ---------------------------------------------------------------------------
LRS_DB_PATH=C:/Users/sehyu/Documents/Other/Projects/trading_assistant_agent/_references/k_stock_trader/data/lrs.db
LRS_EXPORT_ROOT=packages/trading_assistant_data/data/raw/lrs
LRS_SOURCE_LABEL=lrs_local_research_export
LRS_EXPORT_ID=
LRS_CONFIG_HASH=
LRS_CORPORATE_ACTION_POLICY=krx_split_adjusted_policy_v1

# ---------------------------------------------------------------------------
# Hyperliquid crypto data refresh
# Public candle/funding downloads do not require wallet credentials.
# ---------------------------------------------------------------------------
HYPERLIQUID_BASE_URL=https://api.hyperliquid.xyz
HYPERLIQUID_SYMBOLS=BTC,ETH,SOL
HYPERLIQUID_INTERVALS=1m,5m,15m,30m,1h,4h,1d
HYPERLIQUID_INCLUDE_FUNDING=true
HYPERLIQUID_YEARS=0
HYPERLIQUID_LOOKBACK_DAYS=30
HYPERLIQUID_OVERLAP_BARS=200

# ---------------------------------------------------------------------------
# Calendar, adjustment, fee, and slippage authority files
# ---------------------------------------------------------------------------
TA_CALENDAR_ROOT=packages/trading_assistant_data/data/calendars
TA_ADJUSTMENT_ROOT=packages/trading_assistant_data/data/adjustments
TA_FEE_MODEL=packages/trading_assistant_data/data/cost_models/fees/fees_v1.json
TA_SLIPPAGE_MODEL=packages/trading_assistant_data/data/cost_models/slippage/slippage_v1.json
TA_CME_CALENDAR=packages/trading_assistant_data/data/calendars/cme_equity_index_futures_v1.json
TA_US_EQUITY_CALENDAR=packages/trading_assistant_data/data/calendars/us_equities_xnys_xnas_v1.json
TA_KRX_CALENDAR=packages/trading_assistant_data/data/calendars/krx_equities_v1.json

# ---------------------------------------------------------------------------
# Optional macro/regime refresh
# ---------------------------------------------------------------------------
FRED_API_KEY=

# ---------------------------------------------------------------------------
# Optional parity/replay database access for legacy diagnostics comparison
# ---------------------------------------------------------------------------
PARITY_POSTGRES_DSN=
DATABASE_URL=
POSTGRES_DSN=

# ---------------------------------------------------------------------------
# Runtime-emitted live deployment metadata imports
# ---------------------------------------------------------------------------
TA_DEPLOYMENT_METADATA_INBOX=packages/trading_assistant_backtest/artifacts/validation/deployment_metadata_install/inbox
TA_RUNTIME_STARTED_AT_UTC=
TA_RUNTIME_INSTANCE_ID=
