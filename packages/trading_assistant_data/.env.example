# When sourced from packages/trading_assistant, MARKET_DATA_ROOT should point here
# for compatibility exports:
MARKET_DATA_ROOT=../trading_assistant_data/data/export

# Optional live sync credentials. Read-only source clients must never place orders.
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=107
IBKR_READ_ONLY_ACK=false
IBKR_ENABLE_PHYSICAL_CONTRACT_BACKFILL=false
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=
KIS_READ_ONLY_ACK=false
KIS_REQUEST_MIN_INTERVAL_SECONDS=2.0
KIS_EXTRA_SLEEP_SECONDS=0.55
KIS_INTRADAY_MAX_PAGES=
